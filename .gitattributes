# 统一换行符,避免 Windows/Linux/CI 之间互相污染 diff
# 规则:仓库里一律存 LF,检出到工作区时由 Git 决定

* text=auto eol=lf

# 明确这些必须是 LF(脚本、配置)
*.sh    text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf

# 二进制文件不要碰
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.zip   binary
*.pdf   binary

# Maven wrapper(以后会用)
mvnw       text eol=lf
mvnw.cmd   text eol=crlf
